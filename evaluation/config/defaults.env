# Shared defaults for TACVM evaluation harnesses.
# Source from scripts:  set -a; source evaluation/config/defaults.env; set +a

TACVM_TEE_BACKEND="${TACVM_TEE_BACKEND:-mock}"
TACVM_VERIFIER_ENDPOINT="${TACVM_VERIFIER_ENDPOINT:-127.0.0.1:50051}"
TACVM_RESULTS_ROOT="${TACVM_RESULTS_ROOT:-results}"
TACVM_HEALTHCHECK_STRICT="${TACVM_HEALTHCHECK_STRICT:-0}"
